{
  "name": "nu-lint",
  "displayName": "Nu-Lint",
  "description": "Linter for NuShell",
  "version": "0.0.14",
  "publisher": "WillemVanhulle",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "nushell",
    "nu",
    "lint",
    "linter",
    "shell"
  ],
  "activationEvents": [
    "onLanguage:nu",
    "onLanguage:nushell"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nu-lint.restartServer",
        "title": "Restart Language Server",
        "category": "Nu-Lint"
      },
      {
        "command": "nu-lint.fixAll",
        "title": "Fix All Auto-Fixable Problems",
        "category": "Nu-Lint",
        "enablement": "editorLangId == nushell || editorLangId == nu"
      },
      {
        "command": "nu-lint.openUserConfig",
        "title": "Open User Configuration",
        "category": "Nu-Lint"
      },
      {
        "command": "nu-lint.showOutput",
        "title": "Show Logs",
        "category": "Nu-Lint"
      }
    ],
    "configuration": {
      "title": "Nu-Lint",
      "properties": {
        "nu-lint.executablePath": {
          "type": "string",
          "default": "nu-lint",
          "description": "Path to the nu-lint executable (version 1.7.0 or newer)"
        },
        "nu-lint.server.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "warn",
          "markdownDescription": "Messages from the nu-lint language server at this level and above appear in the **Nu-Lint** output channel (passed as `--log-level`, needs nu-lint 1.10.0 or newer)."
        },
        "nu-lint.server.logFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Also append language server logs to this file (passed as `--log-file`, needs nu-lint 1.10.0 or newer). Leave empty to log only to the output channel."
        },
        "nu-lint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the nu-lint language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.mjs",
    "icon": "resvg --width 256 --height 256 \"$NU_LINT_LOGO_SVG\" icon.png",
    "logo": "resvg --width 256 --height 256 \"$NU_LINT_LOGO_SVG\" docs/logo.png",
    "build:e2e": "node esbuild.mjs --e2e",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/**/*.test.ts\""
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@vscode/vsce": "^4.1.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "esbuild": "^0.28.2",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "ovsx": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "extensionDependencies": [
    "TheNuProjectContributors.vscode-nushell-lang"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wvhulle/nu-lint-vscode.git"
  },
  "icon": "icon.png",
  "license": "MIT"
}
